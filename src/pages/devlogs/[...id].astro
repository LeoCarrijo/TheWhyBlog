---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
    const devlogs = await getCollection('devlogs');

    return devlogs.map((devlog) => ({
        params: {
            id: devlog.id
        },
        props: {
            devlog
        }
    }));
}

const { devlog } = Astro.props;
const { Content } = await render(devlog);
---

<BaseLayout title={devlog.data.title}>
    <article>
        <header>
            <h1>{devlog.data.title}</h1>

            <p>{devlog.data.description}</p>

            <time datetime={devlog.data.date.toISOString()}>
                {devlog.data.date.toLocaleDateString('pt-BR')}
            </time>
        </header>

        <Content />
    </article>
</BaseLayout>
